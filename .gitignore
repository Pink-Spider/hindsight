# 의존성 / 빌드
node_modules/
dist/
.venv/
__pycache__/
*.pyc

# 생성물 — 전부 재생성 가능. 실제 시세에서 만든 spec은 커밋 금지 (합성 픽스처만 예외)
specs/*
!specs/golden_synthetic.json
out/
data/*.db
data/*.db-shm
data/*.db-wal
assets/bgm/*
!assets/bgm/.gitkeep

# 시크릿 — P4 YouTube OAuth 클라이언트/토큰은 반드시 .env로만 다룬다
.env
.env.*
*credentials*.json
*client_secret*.json

# 로컬 도구
.idea/
.claude/settings.local.json
.remember/
.playwright-mcp/
.DS_Store
